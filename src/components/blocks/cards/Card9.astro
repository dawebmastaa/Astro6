<div class="flex flex-col rounded-box border border-primary/20">
    <!-- Image -->
    <slot name="image"><div class="bg-[url('img/forest.jpg')] bg-center h-72 rounded-t-box "></div></slot>
    <!-- Status -->
    <div class="flex items-center gap-4 py-4 px-6 font-bold text-lg border-y border-y-primary/20">
        <slot name="status"><i class="fa-solid fa-headphones-simple"></i>Default Status</slot>
    </div>
    <!-- Content -->
    <div class="flex flex-col gap-6 bg-base-200 p-6 rounded-b-box">
        <slot name="name"><h1 class="font-bold text-xl">Default Name</h1></slot>
        <slot name="description"><span>Default description text from component</span></slot>
        <!-- Icons -->
        <div class="flex flex-col gap-2">
            <div class="flex gap-3 items-center text-sm">
                <slot name="project"><i class="fa-solid fa-briefcase fa-fw text-accent"></i>Default Project</slot>
            </div>

            <div class="flex gap-3 items-center text-sm">
                <slot name="location"><i class="fa-solid fa-location-dot fa-fw text-accent"></i>Default Location</slot>
            </div>

            <div class="flex gap-3 items-center text-sm">
                <slot name="email"><i class="fa-solid fa-envelope fa-fw text-accent"></i>email@domain</slot>
            </div>
        </div>
    </div>
</div>
