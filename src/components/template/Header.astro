---
import ButtonLink from '@/components/ui/ButtonLink.astro';
import navigationConfig from '@/config/navigation.js';
import ModeSwitch from '@/components/ui/ModeSwitch.astro';

const menuItems = navigationConfig;
const { sitename, currentPath } = Astro.props;

// mobile-menu data and logic
const menuId = 'mobile-menu-2';
const buttonId = 'mobile-menu-button';

function isActive(href:string) {
  // For homepage, exact match only
  if (href === '/') {
    const normalizedCurrent = currentPath.replace(/\/$/, '');
    return normalizedCurrent === '';
  }
  // For other pages, check if current path starts with the href
  const normalizedCurrent = currentPath.replace(/\/$/, '');
  const normalizedHref = href.replace(/\/$/, '');
  return normalizedCurrent === normalizedHref || normalizedCurrent.startsWith(normalizedHref + '/');
}
---
<header class="p-0 m-0 w-full bg-primary-950">
<nav aria-label="Main navigation" class="py-3">
  <div class="flex flex-wrap items-center justify-between max-w-7xl mx-auto">
    <!-- Logo -->
    <a href="/" aria-label="Home" class="flex items-center">
      <img alt="Return to Homepage || Rule The Web" src="logo1.png" class="h-8 lg:h-10 mx-2 sm:my-1">
      <span class="text-indigo-100 tracking-tight font-bold text-3xl lg:text-4xl">Rule The Web</span>
    </a>
    <!-- Right side buttons -->
    <div class="flex items-center lg:order-2 md:gap-4 mr-2">
      <ModeSwitch />
      <span class="hidden sm:inline-flex lg:hidden xl:inline-flex gap-x-4">
        <ButtonLink href="/contact" variant="primary" size="sm">Get Started</ButtonLink>
      </span>
      <!-- Hamburger button -->
      <button
        id="mobile-toggle"
        class="inline-flex items-center p-2 ml-1 text-sm text-primary-100 rounded-lg lg:hidden hover:bg-base-200 focus:outline-none focus:ring-2 focus:ring-base-300"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <span class="sr-only">Open main menu</span>
        <svg id="hamburger" class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd"></path>
        </svg>
        <svg id="close" class="hidden w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
        </svg>
      </button>
    </div>

    <!-- Menu (hidden on mobile) -->
    <div id="mobile-menu" class="hidden w-full lg:flex lg:w-xl lg:order-1">
    <ul class="flex flex-col mt-4 text-lg font-semibold lg:flex-row lg:space-x-8 lg:mt-0">
      {menuItems.map(item => {
        const active = isActive(item.href);
        return (
          <li class="hover:bg-indigo-100 lg:hover:bg-transparent">
            <a href={item.href}
              class={`block py-2 pl-3 pr-4 border-b border-base-500 lg:border-0 lg:p-0 ${active ? "text-indigo-300 font-extrabold" : "text-indigo-100"}`}
              aria-current={active ? "page" : undefined}
            >{item.label}
            </a>
          </li>
        );
      })}
    </ul>
  </div>
  </div>
</nav>
</header>
