---
import ButtonLink from "@/components/ui/ButtonLink.astro";
import Images from "@/components/ui/Images.astro";

const {Img, Alt, HeadingText, FooterText} = Astro.props;
---
  <section class="bg-base-100 text-base-900">
    <div class="grid max-w-7xl px-6 py-4 sm:py-6 md:py-8 xl:py-12 2xl:py-32 mx-auto lg:grid-cols-12">
        <div class="mr-auto place-self-center lg:col-span-5">
            <h1 class="max-w-2xl mb-4 text-2xl font-bold leading-none tracking-tight md:text-3xl xl:text-4xl">{HeadingText}</h1>
            <p class="max-w-2xl mb-6 font-light lg:mb-8 md:text-lg lg:text-xl"><slot /></p>
            <div class="sm:flex sm:space-x-4">
                <ButtonLink href="/blog/" variant="primary" size="md" margin>More Blog Posts</ButtonLink>
                <ButtonLink href="/articles/" variant="outline" size="md" margin>View Articles Section</ButtonLink>
            </div>        
            <p class="mt-3 text-sm">{FooterText}</p>
        </div>
        <div class="hidden lg:m-0 lg:col-span-7 lg:flex">
            <Images srcPath={Img} alt={Alt} title={Alt} component="picture" formats={['avif', 'webp']}
              sizes="(max-width: 768px) 100vw, 1200px" widths={[400, 800, 1200]} 
              className="w-full h-auto rounded-lg" loading="eager" fetchpriority="high"
            />
        </div>
    </div>
  </section>
