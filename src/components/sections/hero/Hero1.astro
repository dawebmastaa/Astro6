---
import ButtonLink from "@/components/ui/ButtonLink.astro";
---
<section class="">
<div class="flex justify-center my-12 lg:my-24">
    <div class="flex flex-col items-center text-center gap-y-6 lg:gap-y-12 max-w-xl">
        <span class="text-base md:text-lg text-accent">Free Stack: The future of the web</span>
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold">The Intuitive Web Solutions</h1>
        <span class="text-base md:text-lg">The future of the web is here. Free Stack is the solution for everyone who wants to participate in the future of the web!</span>
        <div class="flex gap-4">
            <ButtonLink href="/modern-stack-blueprint" variant="primary" size="md">Get started</ButtonLink>
            <ButtonLink href="/performance-demo" variant="outline" size="md">See our blog</ButtonLink>
        </div>
    </div>
</div>
</section>
