---
import ButtonLink from "@/components/ui/ButtonLink.astro";
---
<section class="flex justify-center">
    <div class="flex flex-col items-center text-center gap-12 max-w-lg my-12 lg:my-24">
        <ButtonLink href="" variant="outline" size="sm" class="fa-solid fa-circle-arrow-right ">PRO release - Join waitlist<</ButtonLink>
        <h1 class="text-4xl lg:text-5xl font-bold">Let's build<span class="text-primary"> Together</span></h1>
        <span class="text-base lg:text-md">App Name is an open-source application that leverages your bussiness and help you build amazing products to your costumers</span>
        <div class="flex gap-4">
            <ButtonLink href="" variant="primary" size="md">Get started</ButtonLink>
            <ButtonLink href="" variant="outline" size="md">npm i app-name</ButtonLink>
        </div>
        <ButtonLink href="" variant="outline" size="sm">Installation guide</ButtonLink>
    </div>
</section>
