---
import { getCollection } from "astro:content";
import Card1 from "@/components/blocks/cards/Card1.astro";

const { collection = "articles", limit } = Astro.props;

// Get items, exclude index and drafts
const items = await getCollection(collection, (item) => {
	if (item.id === "index") return false;
	if (item.data.draft) return false;
	return true;
});

// Sort
if (collection === "blog" || collection === "articles") {
	items.sort(
		(a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
	);
}

// Apply limit
const displayItems = limit ? items.slice(0, limit) : items;
---

{displayItems.map(item => {
  const href = `/${collection}/${item.id}`;

  return (
    <Card1>
      <div slot="header">
        <div class="border-primary border flex justify-center items-center mb-4 w-10 h-10 rounded-full lg:h-12 lg:w-12">
            <svg class="w-5 h-5 text-primary lg:w-6 lg:h-6" fill="currentColor" viewBox="0 0 20 20">
            {collection === 'articles' ? (
              <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4zm2 6a1 1 0 011-1h6a1 1 0 110 2H7a1 1 0 01-1-1zm1 3a1 1 0 100 2h6a1 1 0 100-2H7z" clip-rule="evenodd" />
            ) : (
              <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd" />
            )}
            </svg>
        </div>
        <h3 class="m-0 text-xl font-bold"><a href={href} class="text-primary-700 hover:link tooltip tooltip-top tooltip-primary" data-tip="Read More">{item.data.title}</a></h3>
      </div>
      <p class="mb-4">{collection !== 'pages' ? (item.data.excerpt || "Read more...") : (item.data.description || "Learn more...")}</p>
      <span slot="footer" class="text-sm font-semibold">
        <a href={href} class="text-primary-700 hover:link tooltip tooltip-top tooltip-primary" data-tip="Read More">
          {collection === 'blog' || collection === 'articles' ? new Date(item.data.publishDate.getUTCFullYear(), item.data.publishDate.getUTCMonth(), item.data.publishDate.getUTCDate()).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : "Read Article"}
        </a>
      </span>
    </Card1>
  );
})}
