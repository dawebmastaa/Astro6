---
import { getEntry, render } from "astro:content";
import ButtonLink from "@/components/ui/ButtonLink.astro";
import Images from "@/components/ui/Images.astro";
import Layout from "@/layouts/Layout.astro";
import Card2 from "@/components/blocks/cards/Card2.astro";

const home = await getEntry("pages", "index");
const { Content } = await render(home);
const { title, description, robots } = home.data;
---
<Layout title={title} description={description} robots={robots}>
    <Content components={{ ButtonLink, Images, Card2 }} />
</Layout>