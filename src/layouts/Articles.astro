---
const {headingText, headingText2, articleHeading, excerpt, ButtonLink, Images, Card1, HeroImage, imageAlt} = Astro.props;
---
<section class="bg-primary-600 relative overflow-hidden">
  <div class="mx-auto max-w-7xl">
    <div class="py-6 md:py-12 bg-gradient-to-r lg:max-w-2xl relative z-10">
      <div class="mx-auto max-w-7xl">
        <div class="text-center px-2 lg:text-left space-y-6 md:pl-6">
            <h1 class="text-3xl sm:text-4xl tracking-tight font-extrabold text-white">
              <span>{headingText}</span>
              <span class="text-primary-200 block">{headingText2}</span>
            </h1>
            <p class="text-white md:text-lg lg:text-xl sm:max-w-xl mx-auto lg:mx-0">{excerpt}</p>
            <div class="mt-5 sm:flex sm:justify-center lg:justify-start gap-x-2">
              <div class="mt-5 sm:flex sm:justify-center lg:justify-start gap-x-2">
                <ButtonLink href="/articles/" variant="primary" size="md">More Articles</ButtonLink>
                <ButtonLink href="/blog/" variant="white-primary" size="md">Read The Blog</ButtonLink>
              </div>
            </div>
        </div>
      </div>
    </div>
  </div>
  <div class="lg:absolute lg:inset-y-0 lg:right-0 lg:w-2/3">
    <Images
        srcPath={HeroImage}
        alt={imageAlt}
        component="picture"
        formats={['avif', 'webp']}
        sizes="(max-width: 768px) 100vw, 1200px"
        widths={[400, 800, 1200]}
        className="object-cover h-56 w-full sm:h-72 md:h-96 lg:w-full lg:h-full"
        loading="eager"
        fetchpriority="high"
      />
  </div>
</section>

<section class="bg-base-200">
  <div class="max-w-324 px-2 py-2 sm:py-6 mx-auto">
    <Card1>
      <div slot="header"><h2 class="text-2xl sm:text-3xl tracking-tight font-extrabold m-0">{articleHeading}</h2></div>
      <article class="p-0 font-light text-md md:text-lg lg:text-xl prose dark:prose-invert max-w-none">
        <slot />
      </article>
      <span slot="footer" class="text-sm font-semibold"><a href="/articles/" class="text-primary-700 hover:link tooltip tooltip-top tooltip-primary" data-tip="Back to Articles">Back to Articles </a></span>
    </Card1>
  </div>
</section>
